def Xform "World"
{
    def Scope "Looks"
    {
        def Material "ABS_Hard_Leather_Brown"
        {
            token outputs:mdl:displacement.connect = </World/Looks/ABS_Hard_Leather_Brown/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/ABS_Hard_Leather_Brown/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/ABS_Hard_Leather_Brown/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/ABS_Hard_Leather_Brown/PreviewSurface.outputs:surface>

            # UsdPreviewSurface approximation of the MDL material, for renderers without MDL (e.g. Storm in usdview).
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.15, 0.07)
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/vMaterials_2/Leather/ABS_Hard_Leather.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "ABS_Hard_Leather_Brown"
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "ABS_Hard_Leather_Deep_Green"
        {
            token outputs:mdl:displacement.connect = </World/Looks/ABS_Hard_Leather_Deep_Green/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/ABS_Hard_Leather_Deep_Green/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/ABS_Hard_Leather_Deep_Green/Shader.outputs:out>
            token outputs:surface.connect = </World/Looks/ABS_Hard_Leather_Deep_Green/PreviewSurface.outputs:surface>

            # UsdPreviewSurface approximation of the MDL material, for renderers without MDL (e.g. Storm in usdview).
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.22, 0.1)
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @https://omniverse-content-production.s3.us-west-2.amazonaws.com/Materials/2023_1/vMaterials_2/Leather/ABS_Hard_Leather.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "ABS_Hard_Leather_Deep_Green"
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }
}

